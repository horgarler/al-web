---
import { getCollection } from 'astro:content';

import Bilingue from '../components/Bilingue.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/*
 * News es una sola pagina, como en WordPress: arriba los enlaces a prensa y
 * debajo la rejilla de flyers. No hay ficha por noticia, asi que no se generan
 * rutas /news/<slug>/.
 */
const noticias = (await getCollection('noticias')).sort((a, b) => {
  const fa = a.data.fecha?.getTime() ?? 0;
  const fb = b.data.fecha?.getTime() ?? 0;
  return fb - fa;
});

const conEnlace = noticias.filter((n) => n.data.enlace);
---

<BaseLayout titulo="News">
  <div class="pagina">
    <h1>news</h1>

    {
      noticias.length === 0 ? (
        <Bilingue
          class="vacio"
          texto={{ es: 'Todavía no hay noticias.', en: 'No news yet.' }}
        />
      ) : (
        <ul class="enlaces">
          {conEnlace.map((n) => (
            <li>
              <a href={n.data.enlace!} rel="noopener noreferrer" target="_blank">
                {n.data.titulo.es}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .pagina {
    padding: var(--espacio-l);
  }

  h1 {
    margin-top: 0;
    font-size: var(--texto-xl);
    font-weight: 400;
  }

  .enlaces {
    padding-left: 0;
    list-style: none;
  }

  .enlaces li {
    margin-bottom: var(--espacio-m);
  }

  .vacio {
    color: var(--color-tenue);
  }
</style>
