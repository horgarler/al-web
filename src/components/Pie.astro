---
/**
 * Pie de la barra lateral. La linea de creditos es un marcador hasta que se
 * sustituya en `src/config/plantilla.ts` (prompt 02); mientras tanto no se
 * pinta, para no enseñar corchetes en produccion.
 */
import { sitio } from '../config/site';
import { RE_MARCADOR } from '../lib/convenciones';

// TODO (prompt 02): mover a src/config/plantilla.ts.
const CREDITOS = '[creditos]';

const anio = new Date().getFullYear();
const creditosPendientes = RE_MARCADOR.test(CREDITOS);
---

<footer class="pie">
  <p class="copyright">© {anio} {sitio.nombre}</p>
  {creditosPendientes ? null : <p class="creditos">{CREDITOS}</p>}
</footer>

<style>
  .pie {
    font-size: var(--texto-s);
    font-style: italic;
  }

  .pie p {
    margin: 0;
  }

  .copyright {
    color: var(--color-acento);
  }

  .creditos {
    color: var(--color-tenue);
  }
</style>
