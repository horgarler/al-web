---
/**
 * Imagen de la home. En esta fase es una sola imagen fija; la rotacion de tres
 * con fundido cruzado llega con el prompt 02.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { PRESETS_IMAGEN } from '../config/site';

export interface Props {
  imagen?: ImageMetadata | null;
  alt?: string;
  /** `object-position`, para controlar el recorte en movil. */
  posicion?: string;
  /** Nombre del marcador, si la imagen todavia no esta puesta. */
  marcador?: string | null;
}

const {
  imagen = null,
  alt = '',
  posicion = '50% 50%',
  marcador = null,
} = Astro.props;

const preset = PRESETS_IMAGEN.hero;
---

<div class="hero">
  {
    imagen ? (
      <Picture
        src={imagen}
        formats={['webp']}
        widths={[...preset.widths]}
        sizes={preset.sizes}
        alt={alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`object-position: ${posicion}`}
      />
    ) : (
      <p class="marcador">{marcador ?? 'Sin imagen'}</p>
    )
  }
</div>

<style>
  .hero {
    width: 100%;
    height: 100%;
    min-height: 100dvh;
  }

  .hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mientras el marcador no se sustituya, un bloque gris con su nombre. */
  .marcador {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    margin: 0;
    background: #1a1a1a;
    color: var(--color-tenue);
    font-family: monospace;
  }
</style>
